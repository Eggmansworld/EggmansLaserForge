<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Ldp.App.ImportReportDialog"
        Title="Import finished" Width="720" SizeToContent="Height" MaxHeight="640"
        WindowStartupLocation="CenterOwner" CanResize="True"
        Background="{DynamicResource BgPanel}">
    <DockPanel Margin="18">
        <TextBlock DockPanel.Dock="Top" Name="HeadlineText" FontSize="15" FontWeight="Bold"
                   Foreground="{DynamicResource FgPrimary}" TextWrapping="Wrap"/>
        <TextBlock DockPanel.Dock="Top" Name="SubText" FontSize="12" Margin="0,4,0,10"
                   Foreground="{DynamicResource FgFaint}" TextWrapping="Wrap"/>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                    Spacing="8" Margin="0,12,0,0">
            <Button Name="CopyButton" Content="⧉ Copy these" Click="OnCopy"/>
            <Button Name="CloseButton" Content="Close" Click="OnClose" IsDefault="True" IsCancel="True"/>
        </StackPanel>

        <Border Background="{DynamicResource BgCanvas}" CornerRadius="4" Padding="10,8">
            <ScrollViewer>
                <!-- One block so a passage can be dragged out across lines. -->
                <SelectableTextBlock Name="WarningsText" Foreground="{DynamicResource FgMuted}"
                                     FontFamily="Consolas,monospace" FontSize="12" TextWrapping="Wrap"/>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
