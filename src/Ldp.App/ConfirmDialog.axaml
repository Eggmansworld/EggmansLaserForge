<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Ldp.App.ConfirmDialog"
        Title="Confirm" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" CanResize="False"
        Background="{DynamicResource BgPanel}">
    <StackPanel Margin="18" Spacing="10">
        <TextBlock Name="HeadlineText" FontSize="15" FontWeight="Bold"
                   Foreground="{DynamicResource FgPrimary}" TextWrapping="Wrap"/>
        <TextBlock Name="BodyText" FontSize="12" Foreground="{DynamicResource FgMuted}"
                   TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,6,0,0">
            <Button Name="CancelButton" Content="Cancel" Click="OnCancel" IsCancel="True"/>
            <Button Name="OkButton" Content="Go ahead" Click="OnConfirm" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
