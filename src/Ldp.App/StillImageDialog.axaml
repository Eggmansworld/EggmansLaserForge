<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:Ldp.App"
        x:Class="Ldp.App.StillImageDialog"
        Title="Still Image → M2V"
        Width="820" Height="880" MinWidth="700" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgWindow}">

    <DockPanel Margin="0">

        <!-- Pinned bottom: progress + actions -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource BgBar}"
                BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Padding="18,12">
            <StackPanel Spacing="8">
                <StackPanel Name="ProgressArea" Spacing="4" IsVisible="False">
                    <ProgressBar Name="StillProgress" Minimum="0" Maximum="1" Height="8"/>
                    <TextBlock Name="ProgressStatus" Foreground="{DynamicResource FgPrimary}"
                               FontSize="14" FontWeight="SemiBold" Text=""/>
                    <TextBlock Name="ProgressDetail" Foreground="{DynamicResource FgPrimary}"
                               FontFamily="Consolas,monospace" FontSize="12" Text="" TextTrimming="CharacterEllipsis"/>
                    <Border Background="{DynamicResource BgCanvas}" CornerRadius="4" Padding="8" Height="110">
                        <ScrollViewer Name="OutputScroll">
                            <TextBlock Name="OutputLog" Foreground="{DynamicResource FgMuted}"
                                       FontFamily="Consolas,monospace" FontSize="12" TextWrapping="Wrap" Text=""/>
                        </ScrollViewer>
                    </Border>
                </StackPanel>

                <DockPanel>
                    <CheckBox Name="AutoAddCheck" DockPanel.Dock="Left" VerticalAlignment="Center"
                              Click="OnAutoAddToggled" Content="Add finished passages to the project as videos"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Name="GenerateButton" Content="▶ Generate" IsEnabled="False" Click="OnGenerate"/>
                        <Button Name="CloseButton" Content="Close" Click="OnClose"/>
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- Scrollable options -->
        <ScrollViewer>
            <StackPanel Margin="18" Spacing="14">

                <TextBlock Text="Turn a still image into a short video passage" FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource FgPrimary}"/>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource FgMuted}" FontSize="13"
                           Text="Singe has no way to show an image file — every instructions page, menu background and difficulty screen is a frame number on the disc. So artwork has to become video first. Point at a PNG and this writes a short .m2v your script can aim at."/>

                <!-- FFMPEG -->
                <Border Background="{DynamicResource BgPanel}" CornerRadius="6" Padding="14">
                    <StackPanel Spacing="8">
                        <TextBlock Text="FFMPEG" Foreground="{DynamicResource FgFaint}" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Name="FfmpegStatus" TextWrapping="Wrap" FontSize="13"
                                   Foreground="{DynamicResource AccentAmber}" Text="Locate ffmpeg.exe to begin."/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Name="LocateFfmpegButton" Content="Locate ffmpeg.exe…" Click="OnLocateFfmpeg"/>
                            <TextBlock Name="FfmpegDownloadLink" VerticalAlignment="Center" FontSize="13"
                                       Foreground="{DynamicResource Accent}" Cursor="Hand"
                                       Text="Download the full build (gyan.dev)" PointerPressed="OnOpenFfmpegDownload"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- SOURCE IMAGES -->
                <Border Background="{DynamicResource BgPanel}" CornerRadius="6" Padding="14">
                    <StackPanel Spacing="8">
                        <TextBlock Text="SOURCE IMAGES  (png, jpg, bmp, webp)" Foreground="{DynamicResource FgFaint}"
                                   FontSize="11" FontWeight="Bold"/>
                        <ListBox Name="ImageList" Height="110" Background="{DynamicResource BgCanvas}"
                                 SelectionChanged="OnImageSelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="app:StillSourceItem">
                                    <StackPanel Margin="2">
                                        <TextBlock Text="{Binding Name}" FontSize="13" ToolTip.Tip="{Binding Path}"
                                                   Foreground="{DynamicResource FgPrimary}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Info}" FontSize="11"
                                                   Foreground="{DynamicResource FgMuted}"
                                                   FontFamily="Consolas,monospace" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Name="AddImagesButton" Content="＋ Add images…" Click="OnAddImages"/>
                            <Button Name="RemoveImageButton" Content="Remove" IsEnabled="False" Click="OnRemoveImage"/>
                            <Button Name="ClearImagesButton" Content="Clear" IsEnabled="False" Click="OnClearImages"/>
                            <TextBlock Name="ImageCount" VerticalAlignment="Center" FontSize="12"
                                       Foreground="{DynamicResource FgMuted}" Text=""/>
                        </StackPanel>
                        <TextBlock Name="MultiNote" IsVisible="False" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource FgMuted}"
                                   Text="With more than one image every passage uses the same length and fade, and each output is named after its own image."/>
                    </StackPanel>
                </Border>

                <!-- PICTURE -->
                <Border Background="{DynamicResource BgPanel}" CornerRadius="6" Padding="14">
                    <StackPanel Spacing="8">
                        <TextBlock Text="PICTURE" Foreground="{DynamicResource FgFaint}" FontSize="11" FontWeight="Bold"/>

                        <TextBlock Name="MatchedNote" TextWrapping="Wrap" FontSize="12" IsVisible="False"
                                   Foreground="{DynamicResource FgMuted}" Text=""/>

                        <StackPanel Name="PictureEditPanel" Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="Size" VerticalAlignment="Center" Width="46"
                                           Foreground="{DynamicResource FgPrimary}" FontSize="13"/>
                                <NumericUpDown Name="WidthBox" Width="120" Value="1600" Minimum="16" Maximum="4096"
                                               Increment="2" FormatString="0" ValueChanged="OnNumberChanged"/>
                                <TextBlock Text="×" VerticalAlignment="Center" Foreground="{DynamicResource FgMuted}"/>
                                <NumericUpDown Name="HeightBox" Width="120" Value="900" Minimum="16" Maximum="4096"
                                               Increment="2" FormatString="0" ValueChanged="OnNumberChanged"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="Rate" VerticalAlignment="Center" Width="46"
                                           Foreground="{DynamicResource FgPrimary}" FontSize="13"/>
                                <ComboBox Name="FpsCombo" MinWidth="290" SelectionChanged="OnFpsChanged"/>
                            </StackPanel>
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource FgFaint}" FontSize="12"
                                       Text="MPEG-2 stores the frame rate as a fixed code, so only these eight rates exist. Every video in one game must share the same rate — Singe times all its moves in frames."/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="Fit" VerticalAlignment="Center" Width="46"
                                       Foreground="{DynamicResource FgPrimary}" FontSize="13"/>
                            <ComboBox Name="FitCombo" MinWidth="290" SelectionChanged="OnFitChanged"/>
                        </StackPanel>
                        <TextBlock Name="AspectWarning" IsVisible="False" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource AccentAmber}" Text=""/>
                    </StackPanel>
                </Border>

                <!-- LENGTH -->
                <Border Background="{DynamicResource BgPanel}" CornerRadius="6" Padding="14">
                    <StackPanel Spacing="8">
                        <TextBlock Text="LENGTH" Foreground="{DynamicResource FgFaint}" FontSize="11" FontWeight="Bold"/>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <NumericUpDown Name="LengthBox" Width="130" Value="5" Minimum="0.1" Maximum="600"
                                           Increment="0.5" FormatString="0.##" ValueChanged="OnNumberChanged"/>
                            <TextBlock Text="seconds" VerticalAlignment="Center"
                                       Foreground="{DynamicResource FgMuted}" FontSize="13"/>
                            <TextBlock Name="FrameCountText" VerticalAlignment="Center" FontSize="13"
                                       FontFamily="Consolas,monospace" Foreground="{DynamicResource Accent}" Text=""/>
                        </StackPanel>

                        <CheckBox Name="FadeCheck" Click="OnFadeToggled" Content="Fade in and out of black"/>
                        <StackPanel Name="FadePanel" Orientation="Horizontal" Spacing="8" Margin="26,0,0,0"
                                    IsVisible="False" VerticalAlignment="Center">
                            <TextBlock Text="in" VerticalAlignment="Center"
                                       Foreground="{DynamicResource FgPrimary}" FontSize="13"/>
                            <NumericUpDown Name="FadeInBox" Width="110" Value="0.5" Minimum="0" Maximum="60"
                                           Increment="0.1" FormatString="0.##" ValueChanged="OnNumberChanged"/>
                            <TextBlock Text="s     out" VerticalAlignment="Center"
                                       Foreground="{DynamicResource FgPrimary}" FontSize="13"/>
                            <NumericUpDown Name="FadeOutBox" Width="110" Value="0.5" Minimum="0" Maximum="60"
                                           Increment="0.1" FormatString="0.##" ValueChanged="OnNumberChanged"/>
                            <TextBlock Text="s" VerticalAlignment="Center"
                                       Foreground="{DynamicResource FgPrimary}" FontSize="13"/>
                        </StackPanel>
                        <TextBlock Name="FadeHint" IsVisible="False" TextWrapping="Wrap" FontSize="12"
                                   Margin="26,0,0,0" Foreground="{DynamicResource FgFaint}"
                                   Text="The fade-out is placed so it finishes on the last frame. A single-frame still slot never plays the fade — it only matters for passages the framework plays through, like the attract videos."/>
                        <TextBlock Name="ProblemsText" IsVisible="False" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource PortDeath}" Text=""/>
                    </StackPanel>
                </Border>

                <!-- OUTPUT -->
                <Border Background="{DynamicResource BgPanel}" CornerRadius="6" Padding="14">
                    <StackPanel Spacing="8">
                        <TextBlock Text="OUTPUT" Foreground="{DynamicResource FgFaint}" FontSize="11" FontWeight="Bold"/>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="Name" VerticalAlignment="Center" Width="52"
                                       Foreground="{DynamicResource FgPrimary}" FontSize="13"/>
                            <TextBox Name="OutNameBox" Width="330" FontSize="13" PlaceholderText="output.m2v"
                                     TextChanged="OnOutNameChanged"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="Folder" VerticalAlignment="Center" Width="52"
                                       Foreground="{DynamicResource FgPrimary}" FontSize="13"/>
                            <SelectableTextBlock Name="OutFolderText" VerticalAlignment="Center" FontSize="12"
                                                 FontFamily="Consolas,monospace" MaxWidth="520"
                                                 TextTrimming="CharacterEllipsis"
                                                 Foreground="{DynamicResource FgMuted}" Text=""/>
                            <Button Name="BrowseFolderButton" Content="Change…" FontSize="12" Padding="8,3"
                                    Click="OnBrowseFolder"/>
                        </StackPanel>
                        <TextBlock Name="OutNameNote" IsVisible="False" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource AccentAmber}" Text=""/>

                        <StackPanel Name="SlotPanel" Spacing="6" Margin="0,6,0,0" IsVisible="False">
                            <TextBlock Text="Use it for" Foreground="{DynamicResource FgPrimary}" FontSize="13"/>
                            <ComboBox Name="SlotCombo" MinWidth="440" MaxWidth="560"
                                      SelectionChanged="OnSlotChanged"/>
                            <TextBlock Name="SlotHint" TextWrapping="Wrap" FontSize="12"
                                       Foreground="{DynamicResource FgFaint}" Text=""/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- COMMAND PREVIEW -->
                <Border Background="{DynamicResource BgPanel}" CornerRadius="6" Padding="14">
                    <StackPanel Spacing="8">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="COMMAND" Foreground="{DynamicResource FgFaint}"
                                       FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Button DockPanel.Dock="Right" Name="CopyButton" Content="Copy command"
                                    HorizontalAlignment="Right" FontSize="12" Padding="8,3" Click="OnCopyCommand"/>
                            <TextBlock Name="CommandNote" HorizontalAlignment="Right" Margin="0,0,10,0"
                                       VerticalAlignment="Center" Foreground="{DynamicResource FgMuted}"
                                       FontSize="11" Text=""/>
                        </DockPanel>
                        <Border Background="{DynamicResource BgCanvas}" CornerRadius="4" Padding="10">
                            <TextBox Name="CommandBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                     FontFamily="Consolas,monospace" FontSize="12" BorderThickness="0"
                                     Background="Transparent" MinHeight="64"/>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
